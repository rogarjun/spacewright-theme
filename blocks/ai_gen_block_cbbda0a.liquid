{% doc %}
  @prompt
    Generate a three-column grid section. Each column should be a clickable card with an image, a heading, and a short description. The cards should have a continuous, very slow, and subtle animation where they gently scale up to 101% and back down over several seconds, creating a calm 'breathing' or 'pulsing' effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-three-column-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-three-column-grid__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    animation: ai-breathing-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite;
  }

  .ai-three-column-grid__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 4 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | plus: 0.1 }});
  }

  .ai-three-column-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-three-column-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-three-column-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-three-column-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-three-column-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-column-grid__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.content_spacing }}px;
    line-height: 1.3;
  }

  .ai-three-column-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  @keyframes ai-breathing-{{ ai_gen_id }} {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.01);
    }
  }

  @media screen and (max-width: 990px) {
    .ai-three-column-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-three-column-grid__container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-three-column-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-three-column-grid__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-three-column-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-grid__container-{{ ai_gen_id }}">
    <div class="ai-three-column-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign heading_key = 'card_' | append: i | append: '_heading'
          assign description_key = 'card_' | append: i | append: '_description'
          assign link_key = 'card_' | append: i | append: '_link'

          assign card_image = block.settings[image_key]
          assign card_heading = block.settings[heading_key]
          assign card_description = block.settings[description_key]
          assign card_link = block.settings[link_key]
        %}

        <a
          href="{{ card_link | default: '#' }}"
          class="ai-three-column-grid__card-{{ ai_gen_id }}"
          {% unless card_link %}onclick="return false;"{% endunless %}
          style="animation-delay: {{ forloop.index0 | times: 0.5 }}s;"
        >
          <div class="ai-three-column-grid__image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 600 }}"
                alt="{{ card_image.alt | escape }}"
                class="ai-three-column-grid__image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="{{ block.settings.image_height }}"
              >
            {% else %}
              <div class="ai-three-column-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-three-column-grid__content-{{ ai_gen_id }}">
            {% if card_heading != blank %}
              <h3 class="ai-three-column-grid__heading-{{ ai_gen_id }}">
                {{ card_heading }}
              </h3>
            {% endif %}

            {% if card_description != blank %}
              <p class="ai-three-column-grid__description-{{ ai_gen_id }}">
                {{ card_description }}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

